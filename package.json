{
  "name": "asha",
  "private": true,
  "version": "0.1.0",
  "description": "Asha — modern container-streaming / VDI / DaaS platform (anthracite + gold). A Naiemi Group product.",
  "author": "Naiemi Group",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build --concurrency=4",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @asha/web dev",
    "dev:api": "pnpm --filter @asha/api start:dev",
    "dev:agent": "pnpm --filter @asha/agent start:dev",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @asha/db generate",
    "db:migrate": "pnpm --filter @asha/db migrate",
    "db:seed": "pnpm --filter @asha/db seed",
    "db:studio": "pnpm --filter @asha/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "eslint": "^9",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "@simplewebauthn/server": ">=13.3.2",
      "@xmldom/xmldom": "^0.8.15",
      "body-parser": ">=1.20.6",
      "deepmerge-ts": ">=8.0.0",
      "file-type": ">=21.3.2",
      "form-data": ">=4.0.6",
      "ip-address": "^10.3.1",
      "js-yaml": "^4.3.1",
      "lodash": ">=4.18.0",
      "multer": ">=2.2.0",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.23",
      "protobufjs": "^7.6.5",
      "qs": ">=6.16.0",
      "sharp": ">=0.35.0",
      "socket.io-parser": ">=4.2.7",
      "uuid": ">=11.1.1",
      "ws": ">=8.21.0"
    }
  }
}
